+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package main
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// TestS5_Nil: upstream-shaped inventories (no slots/jit) observed at 0, as a
+// nil localScanState reports (a zero modelInventoryExt), give upstream's changed/ok and no extension.
+func TestS5_Nil(t *testing.T) {
+	d := newDirectory()
+	n0 := emNode("p", 14322)
+	n0.IP = "10.0.0.9"
+	n0.Models = []string{"a"}
+	d.upsert(n0)
+	_, changed, ok := d.applyModels("p", "10.0.0.9", 14322, modelInventory{models: []string{"a"}})
+	assert.True(t, ok && !changed, "identical inventory: changed=%v ok=%v", changed, ok)
+	n, changed, ok := d.applyModels("p", "10.0.0.9", 14322, modelInventory{models: []string{"b"}})
+	assert.True(t, ok && changed, "new inventory: changed=%v ok=%v", changed, ok)
+	assert.Zero(t, n.LocalNodeExt, "extension")
+	_, changed, ok = d.applyModels("p", "10.0.0.1", 14322, modelInventory{models: []string{"c"}})
+	assert.True(t, !ok && !changed, "stale address: changed=%v ok=%v", changed, ok)
+}
diff --git a/services/nvpair-node-scanner/local_s8_test.go b/services/nvpair-node-scanner/local_s8_test.go
new file mode 100644
index 0000000..0c9f234
--- /dev/null
+++ b/services/nvpair-node-scanner/local_s8_test.go
@@ -0,0 +1,65 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package main
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestS8_Nil: S8 is a field carry on NVIDIA's modelInventory, not a signature
+// change. Upstream-shaped /v1/models JSON fetched by a daemon without fork
+// state yields a zero modelInventoryExt (observedAt lives in the extension and
+// is stamped only by a non-nil localScanState at fetch time), and refresh then
+// reports changed exactly as upstream: first populate, not an identical sweep,
+// a downloadedByEngine-only change.
+func TestS8_Nil(t *testing.T) {
+	d := newRefreshTestDaemon()
+	body := map[string]any{"models": []string{"a"}, "modelsByEngine": map[string][]string{"vllm": {"a"}},
+		"loadedByEngine": map[string][]string{"vllm": {"a"}}, "downloadedByEngine": map[string][]string{"vllm": {"a"}}}
+	stub, port := startModelsStub(t, http.StatusOK, body)
+	inv, ok := d.fetchModels("127.0.0.1", port, "")
+	require.True(t, ok)
+	assert.Zero(t, inv.local, "upstream-shaped answer must give a zero extension")
+	seedEMNode(d, "p", "127.0.0.1", port)
+	assert.True(t, d.refreshNodeModels("p", "127.0.0.1", port, ""), "first populate")
+	assert.False(t, d.refreshNodeModels("p", "127.0.0.1", port, ""), "identical sweep")
+	body["downloadedByEngine"] = map[string][]string{"vllm": {"a", "b"}}
+	stub.set(http.StatusOK, body)
+	assert.True(t, d.refreshNodeModels("p", "127.0.0.1", port, ""), "downloadedByEngine-only change")
+	got, _ := d.dir.get("p")
+	assert.Equal(t, []string{"a", "b"}, got.DownloadedByEngine["vllm"])
+	assert.Zero(t, got.LocalNodeExt)
+}
+
+// TestLocalDownloadedChangeKeepsCapacity: with fork state, a
+// downloadedByEngine-only change stores the fetch's slots, jit_load and a fresh
+// observed-at, and a capacity-only change keeps upstream's downloaded set.
+func TestLocalDownloadedChangeKeepsCapacity(t *testing.T) {
+	d := newLocalTestDaemon()
+	body := slotBody(2, false)
+	stub, port := startModelsStub(t, http.StatusOK, body)
+	seedEMNode(d, "p", "127.0.0.1", port)
+	require.True(t, d.refreshNodeModels("p", "127.0.0.1", port, ""))
+	body["downloadedByEngine"] = map[string][]string{"lmstudio": {"a", "z"}}
+	stub.set(http.StatusOK, body)
+	require.True(t, d.refreshNodeModels("p", "127.0.0.1", port, ""), "downloaded-only change")
+	got, _ := d.dir.get("p")
+	assert.Equal(t, []string{"a", "z"}, got.DownloadedByEngine["lmstudio"])
+	assert.Equal(t, 2, got.SlotsByEngine["lmstudio"]["a"].Slots)
+	assert.NotZero(t, got.ModelsObservedAt)
+	stub.set(http.StatusOK, mergeBody(slotBody(5, false), "downloadedByEngine", body["downloadedByEngine"]))
+	require.True(t, d.refreshNodeModels("p", "127.0.0.1", port, ""), "capacity-only change")
+	got, _ = d.dir.get("p")
+	assert.Equal(t, 5, got.SlotsByEngine["lmstudio"]["a"].Slots)
+	assert.Equal(t, []string{"a", "z"}, got.DownloadedByEngine["lmstudio"])
+}
+
+func mergeBody(b map[string]any, k string, v any) map[string]any {
+	b[k] = v
+	return b
+}
diff --git a/services/shared/noderec/local_ext.go b/services/shared/noderec/local_ext.go
new file mode 100644
index 0000000..fc9c596
--- /dev/null
+++ b/services/shared/noderec/local_ext.go
@@ -0,0 +1,39 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package noderec
+
+// LocalNodeExt is the fork's extension of DirectoryNode (seam S1): per-engine
+// slot capacity, jit_load flags and the models-observed heartbeat. It is
+// embedded, so encoding/json flattens it and the wire keys are unchanged.
+type LocalNodeExt struct {
+	// SlotsByEngine is the parallel capacity of each engine's loaded models
+	// (engine -> model -> SlotInfo), enriched from engine-manager's em /v1/models
+	// slotsByEngine field with node-settings overrides applied. A missing engine
+	// or model means "capacity unknown" (never "one slot"). Absent on records from
+	// older peers.
+	SlotsByEngine map[string]map[string]SlotInfo `json:"slotsByEngine,omitempty"`
+	// JITLoadByEngine says whether an engine loads a missing model on demand
+	// (engine -> bool), resolved from the jit_load.<engine> setting or the engine
+	// default (see DefaultJITLoad). A missing engine key means the peer did not
+	// say; treat as the engine default.
+	JITLoadByEngine map[string]bool `json:"jitLoadByEngine,omitempty"`
+	// ModelsObservedAt is when (Unix milliseconds) the scanner last completed a
+	// successful models fetch for this node, whether or not the inventory
+	// changed. An unchanged sweep advances it only once it is 30s ahead of the
+	// published value, so it is a bounded-staleness heartbeat (<= ~30s plus a
+	// sweep behind the true last fetch), not a per-sweep value. 0 when never set
+	// (older peers).
+	ModelsObservedAt int64 `json:"modelsObservedAt,omitempty"`
+}
+
+// SlotInfo is a loaded model's parallel capacity: concurrent request slots and
+// the context window each slot gets (0 when unknown). It mirrors the
+// engine-manager wire shape.
+type SlotInfo struct {
+	Slots      int `json:"slots"`
+	CtxPerSlot int `json:"ctxPerSlot,omitempty"`
+	// Bytes is the model's resident size when a record declares "bytes"
+	// (model_sizes); internal, never part of the wire shape.
+	Bytes int64 `json:"-"`
+}
diff --git a/services/shared/noderec/local_s1_test.go b/services/shared/noderec/local_s1_test.go
