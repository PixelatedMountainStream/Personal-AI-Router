diff --git a/services/nvpair-job-scheduler/local_rank.go b/services/nvpair-job-scheduler/local_rank.go
new file mode 100644
index 0000000..3c113b8
--- /dev/null
+++ b/services/nvpair-job-scheduler/local_rank.go
@@ -0,0 +1,43 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package main
+
+import (
+	"slices"
+	"time"
+
+	"nvpair-shared/schedulerwire"
+)
+
+// localAnnotateRanks fills the fork's rank extension (seam S3): each node's
+// pending work split by engine/model (PendingBy, from the same pending, placed
+// workloads upstream counts) and the compute time. Workloads without a model
+// add no PendingBy entry, so a catalog of upstream-shaped workloads leaves
+// PendingBy nil. The caller holds m.mu.
+func (m *Manager) localAnnotateRanks(ranks []NodeRank, now time.Time) {
+	pendingBy := make(map[string]map[string]int)
+	for _, w := range m.catalog {
+		if !isPending(w) || w.ScheduledOn == "" || w.Model == "" {
+			continue
+		}
+		if _, ok := m.nodes[w.ScheduledOn]; !ok {
+			continue
+		}
+		if pendingBy[w.ScheduledOn] == nil {
+			pendingBy[w.ScheduledOn] = make(map[string]int)
+		}
+		pendingBy[w.ScheduledOn][schedulerwire.PendingKey(w.Engine, w.Model)]++
+	}
+	for i := range ranks {
+		ranks[i].PendingBy = pendingBy[ranks[i].ID]
+		ranks[i].ComputedAt = now.UnixMilli()
+	}
+}
+
+// localRankUnchanged replaces upstream's slices.Equal over comparable ranks:
+// NodeRank.Equal ignores ComputedAt (new on every compute) and compares
+// PendingBy by content.
+func localRankUnchanged(prev, next []NodeRank) bool {
+	return slices.EqualFunc(prev, next, NodeRank.Equal)
+}
diff --git a/services/nvpair-job-scheduler/local_s3_test.go b/services/nvpair-job-scheduler/local_s3_test.go
new file mode 100644
index 0000000..5715175
--- /dev/null
+++ b/services/nvpair-job-scheduler/local_s3_test.go
@@ -0,0 +1,31 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package main
+
+import (
+	"slices"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// TestS3_Nil: upstream-shaped workloads (no model) leave PendingBy nil, and
+// localRankUnchanged decides on the upstream fields exactly as upstream's
+// slices.Equal did.
+func TestS3_Nil(t *testing.T) {
+	m := mgrWith(nopRW{}, []string{"a", "b"},
+		workload{ID: "w", Engine: "ollama", RunID: "run", State: "running", OriginatedFrom: "local", ScheduledOn: "a"},
+	)
+	_, ranks := m.rankAt(time.UnixMilli(1000))
+	for _, r := range ranks {
+		assert.Nil(t, r.PendingBy, "PendingBy without models for %s", r.ID)
+	}
+	plain := []NodeRank{{ID: "a", Pending: 1}, {ID: "b"}}
+	other := slices.Clone(plain)
+	assert.True(t, localRankUnchanged(plain, other), "equal upstream fields are unchanged")
+	other[1].GPUPressure = 3
+	assert.False(t, localRankUnchanged(plain, other), "an upstream field change is a change")
+	assert.False(t, localRankUnchanged(plain, plain[:1]), "a length change is a change")
+}
