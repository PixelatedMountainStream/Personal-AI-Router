@@ -0,0 +1,30 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package respnorm
+
+import "testing"
+
+func TestNormalizeResponsesInput(t *testing.T) {
+	cases := []struct{ name, in, want string }{
+		{"no mid developer", `{"model":"m","input":[{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"}]}]}`, ""},
+		{"leading kept", `{"input":[{"type":"message","role":"developer","content":[{"type":"input_text","text":"sys"}]},{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"}]}]}`, ""},
+		{"mid converted", `{"model":"m","input":[{"type":"message","role":"developer","content":[{"type":"input_text","text":"a"}]},{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"}]},{"type":"message","role":"developer","content":[{"type":"input_text","text":"b"}]}]}`,
+			`{"model":"m","input":[{"type":"message","role":"developer","content":[{"type":"input_text","text":"a"}]},{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"}]},{"content":[{"text":"[developer]\nb","type":"input_text"}],"role":"user","type":"message"}]}`},
+		{"unknown fields preserved", `{"z":1,"input":[{"type":"function_call","name":"f","x":[1,2]},{"type":"message","role":"system","content":[{"type":"input_text","text":"b"}]}],"a":{"k":2}}`,
+			`{"z":1,"input":[{"type":"function_call","name":"f","x":[1,2]},{"content":[{"text":"[developer]\nb","type":"input_text"}],"role":"user","type":"message"}],"a":{"k":2}}`},
+		{"string input", `{"input":"hello"}`, ""},
+		{"invalid json", `{"input":[`, ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			want := c.want
+			if want == "" {
+				want = c.in
+			}
+			if got := string(Normalize([]byte(c.in))); got != want {
+				t.Fatalf("got  %s\nwant %s", got, want)
+			}
+		})
+	}
+}
diff --git a/services/nvpair-proxy/local/routing/notloaded.go b/services/nvpair-proxy/local/routing/notloaded.go
new file mode 100644
index 0000000..19c2735
--- /dev/null
+++ b/services/nvpair-proxy/local/routing/notloaded.go
@@ -0,0 +1,75 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package routing
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"regexp"
+	"time"
+
+	"nvpair-shared/engines"
+)
+
+// notLoadedMaxBody bounds how much of an error body is read to classify it.
+const notLoadedMaxBody = 4096
+
+// notLoadedPatterns match (Ollama's quotes arrive JSON-escaped) each engine's "that model is not loaded" refusal.
+var notLoadedPatterns = map[string]*regexp.Regexp{
+	engines.NameLMStudio: regexp.MustCompile(`(?i)No models loaded`),
+	engines.NameOllama:   regexp.MustCompile(`model \\?"[^"]*\\?" not found`),
+	engines.NameLlamaCPP: regexp.MustCompile(`(?i)model .* not (found|loaded)`),
+}
+
+// errReader replays a read failure after the bytes already read.
+type errReader struct{ err error }
+
+func (e errReader) Read([]byte) (int, error) { return 0, e.err }
+
+// ClassifyNotLoaded reports whether resp is the engine refusing a model that
+// is not loaded. It reads the body only when it is 4 KB or less, and leaves
+// resp.Body byte-identical to what the upstream sent. The read is abandoned
+// when ctx ends or budget elapses, so a silent upstream cannot hold the
+// request's reservation before commit; the body then carries that error. A
+// read that fails part-way never classifies, and its failure is replayed.
+// timeoutErr is what the body carries when budget elapses.
+func ClassifyNotLoaded(ctx context.Context, engine string, resp *http.Response, budget time.Duration, timeoutErr error) bool {
+	re := notLoadedPatterns[engine]
+	if re == nil || resp.Body == nil {
+		return false
+	}
+	orig := resp.Body
+	type result struct {
+		buf []byte
+		err error
+	}
+	ch := make(chan result, 1) // buffered: the reader can always finish
+	go func() {
+		buf, err := io.ReadAll(io.LimitReader(orig, notLoadedMaxBody+1))
+		ch <- result{buf, err}
+	}()
+	timer := time.NewTimer(budget)
+	defer timer.Stop()
+	var res result
+	select {
+	case res = <-ch:
+	case <-ctx.Done():
+		res.err = ctx.Err()
+	case <-timer.C:
+		res.err = timeoutErr
+	}
+	tail := io.Reader(orig)
+	if res.err != nil {
+		// Closing unblocks a still-pending read; the caller sees the failure.
+		_ = orig.Close()
+		tail = errReader{res.err}
+	}
+	resp.Body = struct {
+		io.Reader
+		io.Closer
+	}{io.MultiReader(bytes.NewReader(res.buf), tail), orig}
+	return res.err == nil && len(res.buf) <= notLoadedMaxBody && re.Match(res.buf)
+}
diff --git a/services/nvpair-proxy/local/routing/routing.go b/services/nvpair-proxy/local/routing/routing.go
new file mode 100644
index 0000000..25b5647
--- /dev/null
+++ b/services/nvpair-proxy/local/routing/routing.go
@@ -0,0 +1,74 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package routing is the fork's slot-aware candidate ranking for nvpair-proxy.
+// It knows nothing about the proxy's own types: package main glue
+// (local_proxy.go) converts its candidates to Candidate values and back.
+package routing
+
+// Candidate is one scheduler-listed node as the slot-aware ranking sees it.
+type Candidate struct {
+	ID    string
+	Order int // position in the scheduler's priority list
+	Slots int // concurrent requests the engine serves for the model; >= 1
+	Occ   int // requests occupying those slots now
+	// GPU is the scheduler's GPU pressure plus this proxy's reservations
+	// through any engine's facade (they share the GPU, not the slots).
+	GPU   int
+	Local bool // this host's own node
+	// Cooling is NVIDIA's #144 first-byte cooldown (coolingSet).
+	Cooling bool
+}
+
+// Full reports whether every slot is occupied.
+func (c Candidate) Full() bool { return c.Occ >= c.Slots }
+
+// queue is occupancy per slot, or, when full, the queue a new request would
+// join: (occ-slots+1)/slots.
+func (c Candidate) queue() float64 {
+	slots, occ := float64(c.Slots), float64(c.Occ)
+	if occ >= slots {
+		return (occ - slots + 1) / slots
+	}
+	return occ / slots
+}
+
+// Better reports whether a ranks ahead of b. Keys, outermost first:
+//
+//  1. not cooling: NVIDIA's cooldown demotion is the outer stable partition,
+//     so a cooling node never outranks a non-cooling one, whatever its slots
+//     (the same rule NVIDIA's reserveCandidate applies to load);
+//  2. a free slot;
+//  3. lower queue per slot;
+//  4. lower GPU pressure;
+//  5. the local node;
+//  6. scheduler order.
+func Better(a, b Candidate) bool {
+	if a.Cooling != b.Cooling {
+		return !a.Cooling
+	}
+	if af, bf := a.Full(), b.Full(); af != bf {
+		return !af
+	}
+	if aq, bq := a.queue(), b.queue(); aq != bq {
+		return aq < bq
+	}
+	if a.GPU != b.GPU {
+		return a.GPU < b.GPU
+	}
+	if a.Local != b.Local {
+		return a.Local
+	}
+	return a.Order < b.Order
+}
+
+// Best returns the index of the best candidate, or -1 when cs is empty.
+func Best(cs []Candidate) int {
+	best := -1
+	for i, c := range cs {
+		if best < 0 || Better(c, cs[best]) {
+			best = i
+		}
+	}
+	return best
+}
diff --git a/services/nvpair-proxy/local/routing/routing_test.go b/services/nvpair-proxy/local/routing/routing_test.go
new file mode 100644
index 0000000..cbdf646
--- /dev/null
+++ b/services/nvpair-proxy/local/routing/routing_test.go
@@ -0,0 +1,38 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package routing
+
+import "testing"
+
+// NVIDIA's cooldown is the outer partition: a cooling node with a free slot
+// still ranks behind a full, non-cooling one; within a partition the
+// slot-aware keys decide.
+func TestBetterCoolingIsOuterPartition(t *testing.T) {
+	coolFree := Candidate{ID: "cool", Order: 0, Slots: 4, Cooling: true}
+	warmFull := Candidate{ID: "warm", Order: 1, Slots: 1, Occ: 3}
+	if !Better(warmFull, coolFree) || Better(coolFree, warmFull) {
+		t.Fatal("cooling node outranked a non-cooling one")
+	}
+	warmFree := Candidate{ID: "free", Order: 2, Slots: 1}
+	if got := Best([]Candidate{coolFree, warmFull, warmFree}); got != 2 {
+		t.Fatalf("best = %d, want the free non-cooling node", got)
+	}
+	if got := Best([]Candidate{coolFree, {ID: "cool2", Order: 1, Slots: 1, Occ: 1, Cooling: true}}); got != 0 {
+		t.Fatalf("all cooling: best = %d, want the free one", got)
+	}
+	if Best(nil) != -1 {
+		t.Fatal("empty")
+	}
+}
+
+func TestBetterTieBreaks(t *testing.T) {
+	a := Candidate{ID: "a", Order: 0, Slots: 1}
+	local := Candidate{ID: "l", Order: 1, Slots: 1, Local: true}
+	if !Better(local, a) {
+		t.Fatal("local should win an idle tie ahead of scheduler order")
+	}
+	if !Better(Candidate{Order: 1, Slots: 1, GPU: 0}, Candidate{Order: 0, Slots: 1, GPU: 1, Local: true}) {
+		t.Fatal("lower GPU pressure should beat locality")
+	}
+}
diff --git a/services/nvpair-proxy/local_affinity_test.go b/services/nvpair-proxy/local_affinity_test.go
new file mode 100644
index 0000000..ead2db5
--- /dev/null
+++ b/services/nvpair-proxy/local_affinity_test.go
@@ -0,0 +1,239 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package main
+
+import (
+	"context"
+	"log/slog"
+	"net/http/httptest"
+	"nvpair-proxy/local/affinity"
+	"sync"
+	"testing"
+	"time"
+
+	"nvpair-shared/schedulerwire"
+)
+
+func affinityProxy(t *testing.T, ids ...string) *Proxy {
+	t.Helper()
+	p := withLocal(prProxy(t))
+	ranks := make([]schedulerwire.NodeRank, 0, len(ids))
+	for i, id := range ids {
+		ranks = append(ranks, schedulerwire.NodeRank{ID: id, Rank: i})
+	}
+	applySnapshot(p, schedulerwire.Priority{Nodes: ids, Ranks: ranks})
+	return p
+}
+
+// pick reserves for key over ids and returns the chosen node and the decision.
+func pick(p *Proxy, key string, ids ...string) (string, string) {
+	out, _, d := p.reserveCandidateKey(p.soleFacade(), reservationCandidates(ids...), key)
+	return out[0].id, d
+}
+
+// turn is a finished request: reserve, then release, so the slot is free again.
+func turn(p *Proxy, key string, ids ...string) (string, string) {
+	out, res, d := p.reserveCandidateKey(p.soleFacade(), reservationCandidates(ids...), key)
+	p.releaseReservation(res)
+	return out[0].id, d
+}
+
+func TestAffinity_SequentialTurnsAllHit(t *testing.T) {
+	p := affinityProxy(t, "a", "b")
+	first, _ := turn(p, "conv", "a", "b")
+	for i := 0; i < 5; i++ {
+		if got, d := turn(p, "conv", "a", "b"); got != first || d != affinity.Hit {
+			t.Fatalf("turn %d: %s/%s, want %s/hit", i, got, d, first)
+		}
+	}
+}
+
+func TestAffinity_YieldsToFreeNode(t *testing.T) {
+	p := affinityProxy(t, "a", "b")
+	first, _ := pick(p, "conv", "a", "b") // slot stays held
+	other := map[string]string{"a": "b", "b": "a"}[first]
+	if got, d := pick(p, "conv", "a", "b"); got != other || d != affinity.Yield {
+		t.Fatalf("got %s/%s, want %s/yield", got, d, other)
+	}
+	if got, d := turn(p, "conv", "a", "b"); got != other || d != affinity.Hit {
+		t.Fatalf("not rebound: %s/%s", got, d)
+	}
+}
+
+func TestAffinity_AllFullTolerance(t *testing.T) {
+	p := affinityProxy(t, "a", "b")
+	p.local.capacity = &fakeCap{slots: map[string]int{"a": 1, "b": 1}}
+	bound, _ := pick(p, "conv", "a", "b")
+	other := map[string]string{"a": "b", "b": "a"}[bound]
+	pick(p, "x", "a", "b") // fills the other node
+	// 1 vs 1: within tolerance, stay on the bound node.
+	if got, d := pick(p, "conv", "a", "b"); got != bound || d != affinity.Hit {
+		t.Fatalf("within tolerance: %s/%s", got, d)
+	}
+	// Bound now holds 2 against 1 on the other: 2 <= 1+1 still stays.
+	pick(p, "conv", "a", "b")
+	// 3 against 1 is outside the tolerance: go to the shorter queue.
+	if got, d := pick(p, "conv", "a", "b"); got != other || d != affinity.Rebind {
+		t.Fatalf("outside tolerance: %s/%s, want %s/rebind", got, d, other)
+	}
+}
+
+func TestAffinity_SameKeyStaysOnNode(t *testing.T) {
+	p := affinityProxy(t, "a", "b")
+	first, d1 := turn(p, "conv-1", "a", "b")
+	second, d2 := turn(p, "conv-1", "a", "b")
+	if first != second || d1 != affinity.Miss || d2 != affinity.Hit {
+		t.Fatalf("got %s/%s then %s/%s", first, d1, second, d2)
+	}
+}
+
+func TestAffinity_DifferentKeysSpread(t *testing.T) {
+	p := affinityProxy(t, "a", "b")
+	n1, _ := pick(p, "conv-1", "a", "b")
+	n2, _ := pick(p, "conv-2", "a", "b")
+	if n1 == n2 {
+		t.Fatalf("both conversations landed on %s", n1)
+	}
+}
+
+func TestAffinity_FallsBackAndRebinds(t *testing.T) {
+	p := affinityProxy(t, "a", "b")
+	bound, _ := pick(p, "conv-1", "a", "b")
+	other := map[string]string{"a": "b", "b": "a"}[bound]
+	// Bound node lost the model: absent from the candidate list.
+	got, d := pick(p, "conv-1", other)
+	if got != other || d != affinity.Rebind {
+		t.Fatalf("got %s/%s, want %s/rebind", got, d, other)
+	}
+	// Rebound: the next turn sticks to the new node.
+	if got, d = pick(p, "conv-1", "a", "b"); got != other || d != affinity.Hit {
+		t.Fatalf("after rebind got %s/%s, want %s/hit", got, d, other)
+	}
+	// Bound node no longer reservable (dropped from the scheduler list).
+	p2 := affinityProxy(t, "a", "b")
+	b2, _ := pick(p2, "k", "a", "b")
+	live := map[string]string{"a": "b", "b": "a"}[b2]
+	applySnapshot(p2, schedulerwire.Priority{Nodes: []string{live}, Ranks: []schedulerwire.NodeRank{{ID: live}}})
+	if got, d = pick(p2, "k", "a", "b"); got != live || d != affinity.Rebind {
+		t.Fatalf("unreservable: got %s/%s, want %s/rebind", got, d, live)
+	}
+}
+
+func TestAffinity_NoKeyUnchanged(t *testing.T) {
+	p := affinityProxy(t, "a", "b")
+	n1, d1 := pick(p, "", "a", "b")
+	n2, d2 := pick(p, "", "a", "b")
+	if n1 == n2 || d1 != "" || d2 != "" {
+		t.Fatalf("keyless requests should spread without a decision: %s/%q %s/%q", n1, d1, n2, d2)
+	}
+	if p.local.affinity.Len() != 0 {
+		t.Fatalf("keyless request created a binding")
+	}
+}
+
+func TestAffinity_TTLExpiryAndRefresh(t *testing.T) {
+	p := affinityProxy(t, "a", "b")
+	now := time.Unix(1000, 0)
+	p.local.affinity.Now = func() time.Time { return now }
+	turn(p, "k", "a", "b")
+	now = now.Add(affinity.TTL - time.Second)
+	if _, d := turn(p, "k", "a", "b"); d != affinity.Hit {
+		t.Fatalf("within TTL: %s", d)
+	}
+	now = now.Add(affinity.TTL - time.Second) // refreshed by the hit above
+	if _, d := turn(p, "k", "a", "b"); d != affinity.Hit {
+		t.Fatalf("TTL not refreshed on use: %s", d)
+	}
+	now = now.Add(affinity.TTL + time.Second)
+	if _, d := pick(p, "k", "a", "b"); d != affinity.Miss {
+		t.Fatalf("after TTL: %s", d)
+	}
+}
+
+// reportGate is a slog handler that parks the first "proxy request complete"
+// record (the first statement of the handler's reporting defer, before any
+// codec write) so a test can act while that request is still in reporting. It
+// also records the node and affinity decision of every completion.
+type reportGate struct {
+	blocked chan struct{}
+	release chan struct{}
+	mu      sync.Mutex
+	done    [][2]string // node_id, affinity
+}
+
+func (g *reportGate) Enabled(context.Context, slog.Level) bool { return true }
+func (g *reportGate) WithAttrs([]slog.Attr) slog.Handler       { return g }
+func (g *reportGate) WithGroup(string) slog.Handler            { return g }
+func (g *reportGate) Handle(_ context.Context, r slog.Record) error {
+	if r.Message != "proxy request complete" {
+		return nil
+	}
+	var rec [2]string
+	r.Attrs(func(a slog.Attr) bool {
+		switch a.Key {
+		case "node_id":
+			rec[0] = a.Value.String()
+		case "affinity":
+			rec[1] = a.Value.String()
+		}
+		return true
+	})
+	g.mu.Lock()
+	g.done = append(g.done, rec)
+	first := len(g.done) == 1
+	g.mu.Unlock()
+	if first {
+		close(g.blocked)
+		<-g.release
+	}
+	return nil
+}
+
+// #17: the slot claim must be released once the response is copied, not after
+// reporting, or the next turn of the conversation yields off its bound node.
+func TestAffinity_SlotReleasedBeforeReporting(t *testing.T) {
+	tc := anyCase(t)
+	g := &reportGate{blocked: make(chan struct{}), release: make(chan struct{})}
+	prev := slog.Default()
+	slog.SetDefault(slog.New(g))
+	t.Cleanup(func() { slog.SetDefault(prev) })
+	disc := NewDiscovery()
+	for _, id := range []string{"a", "b"} {
+		srv, _ := newCountingServer(t, 200, "ok")
+		disc.AddManual(nodeForModel(t, id, srv, tc.advertisedModel))
+	}
+	p := withLocal(testProxy(tc.profile, disc, tc.profile.FacadePort))
+	p.local.capacity = &fakeCap{slots: map[string]int{"a": 1, "b": 1}}
+	applySnapshot(p, schedulerwire.Priority{Nodes: []string{"a", "b"}, Ranks: []schedulerwire.NodeRank{{ID: "a"}, {ID: "b", Rank: 1}}})
+	f := p.soleFacade()
+	send := func() {
+		req := tc.inferenceRequest()
+		req.Header.Set("thread-id", "conv")
+		f.handleHTTP(httptest.NewRecorder(), req)
+	}
+	var unblock sync.Once
+	open := func() { unblock.Do(func() { close(g.release) }) }
+	t.Cleanup(open) // a regression must fail fast, not leave a handler parked
+	wait := func(ch <-chan struct{}, what string) {
+		t.Helper()
+		select {
+		case <-ch:
+		case <-time.After(5 * time.Second):
+			t.Fatalf("timed out waiting for %s", what)
+		}
+	}
+	run := func() <-chan struct{} {
+		c := make(chan struct{})
+		go func() { defer close(c); send() }()
+		return c
+	}
+	first := run()
+	wait(g.blocked, "first request to reach reporting") // response copied; parked in reporting
+	wait(run(), "second request to complete")
+	open()
+	wait(first, "first request to complete")
+	if len(g.done) != 2 || g.done[1][1] != affinity.Hit || g.done[1][0] != g.done[0][0] {
+		t.Fatalf("second turn was not an affinity hit on the same node: %v", g.done)
+	}
+}
diff --git a/services/nvpair-proxy/local_capacity.go b/services/nvpair-proxy/local_capacity.go
new file mode 100644
index 0000000..44ed350
--- /dev/null
+++ b/services/nvpair-proxy/local_capacity.go
@@ -0,0 +1,204 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package main
+
+// Fork glue (catch-up step 5): residency eligibility, JIT claims and
+// not-loaded suppression on localState. Capacity sources live in
+// local/capacity; this file only reads them.
+
+import (
+	"time"
+
+	"nvpair-proxy/local/capacity"
+)
+
+// nodeSlots is the slot count routing uses: the provider's answer, else 1.
+func (s *localState) nodeSlots(nodeID, engine, model string) int {
+	if s.capacity != nil {
+		if n, ok := s.capacity.Slots(nodeID, engine, model); ok && n > 0 {
+			return n
+		}
+	}
+	return 1
+}
+
+// eligible reports whether a node may be sent a request for the model: it has
+// it loaded, nothing is known (legacy node), or it is known empty but loads on
+// demand. A node that just refused the model as not loaded is skipped for
+// suppressTTL unless a newer directory sweep shows it loaded.
+func (s *localState) eligible(nodeID, engine, model string) bool {
+	r, seen := ResidencyUnknown, time.Time{}
+	if s.capacity != nil {
+		r, seen = s.capacity.Residency(nodeID, engine, model)
+	}
+	if at, ok := s.suppressedAt(inflightKey{engine, model, nodeID}); ok {
+		if r != ResidencyLoaded || !seen.After(at) {
+			return false
+		}
+	}
+	if s.capacity == nil {
+		return true
+	}
+	if r != ResidencyKnownEmpty {
+		return true
+	}
+	// A JIT load would put a second large model on a node whose other engine
+	// already holds one; the proxy has no sizes, so any loaded model counts.
+	if o, ok := s.capacity.(capacity.OtherEngineLoader); ok && o.OtherEngineLoaded(nodeID, engine) {
+		return false
+	}
+	if !s.capacity.JITLoad(nodeID, engine) {
+		return false
+	}
+	// A JIT load already dispatched here for another engine or model would
+	// make this a second one. The claim is in-process only: concurrent cold
+	// requests through other proxies are out of scope (runbook covers them).
+	return !s.jitClaimedByOther(nodeID, engine, model)
+}
+
+type jitClaim struct{ engine, model string }
+
+// jitReleaseCap bounds how long a released claim stays effective, so a dead
+// scanner cannot wedge a node.
+const jitReleaseCap = 2 * time.Minute
+
+// jitClaimedByOther reports whether a live JIT claim on the node is for a
+// different engine or model. A claim whose request ended stays live until the
+// directory reports a sweep newer than the release (so the load shows as
+// Loaded) or jitReleaseCap passes.
+func (s *localState) jitClaimedByOther(nodeID, engine, model string) bool {
+	s.claimMu.Lock()
+	defer s.claimMu.Unlock()
+	other := func(c jitClaim) bool {
+		return c.engine != engine || capacity.ModelKey(c.engine, c.model) != capacity.ModelKey(engine, model)
+	}
+	for c, n := range s.jitClaims[nodeID] {
+		if n > 0 && other(c) {
+			return true
+		}
+	}
+	now := s.clock()
+	for c, t := range s.jitReleased[nodeID] {
+		expired := now.Sub(t) >= jitReleaseCap
+		if !expired && s.capacity != nil {
+			if _, seen := s.capacity.Residency(nodeID, c.engine, c.model); seen.After(t) {
+				expired = true
+			}
+		}
+		if expired {
+			delete(s.jitReleased[nodeID], c) // lazy cleanup
+			continue
+		}
+		if other(c) {
+			return true
+		}
+	}
+	if len(s.jitReleased[nodeID]) == 0 {
+		delete(s.jitReleased, nodeID)
+	}
+	return false
+}
+
+// LIMITATIONS (documented, not fixed): the JIT claim is in-process, so an
+// engine-manager pinned load and a proxy JIT load on the same node are not
+// coordinated across processes. Clearing an uncertain load elsewhere is a
+// bounded heuristic, not a guarantee.
+
+// claimJIT records a dispatch to a KnownEmpty+JIT node and reports whether it
+// did, so the matching release is exact. Released when the request ends.
+func (s *localState) claimJIT(nodeID, engine, model string) bool {
+	if s.capacity == nil {
+		return false
+	}
+	if r, _ := s.capacity.Residency(nodeID, engine, model); r != ResidencyKnownEmpty || !s.capacity.JITLoad(nodeID, engine) {
+		return false
+	}
+	s.claimMu.Lock()
+	defer s.claimMu.Unlock()
+	if s.jitClaims == nil {
+		s.jitClaims = map[string]map[jitClaim]int{}
+	}
+	if s.jitClaims[nodeID] == nil {
+		s.jitClaims[nodeID] = map[jitClaim]int{}
+	}
+	s.jitClaims[nodeID][jitClaim{engine, model}]++
+	return true
+}
+
+func (s *localState) releaseJIT(nodeID, engine, model string) {
+	s.claimMu.Lock()
+	defer s.claimMu.Unlock()
+	c := jitClaim{engine, model}
+	if s.jitClaims[nodeID][c] <= 1 {
+		delete(s.jitClaims[nodeID], c)
+		if s.jitReleased == nil {
+			s.jitReleased = map[string]map[jitClaim]time.Time{}
+		}
+		if s.jitReleased[nodeID] == nil {
+			s.jitReleased[nodeID] = map[jitClaim]time.Time{}
+		}
+		s.jitReleased[nodeID][c] = s.clock()
+		if len(s.jitClaims[nodeID]) == 0 {
+			delete(s.jitClaims, nodeID)
+		}
+	} else {
+		s.jitClaims[nodeID][c]--
+	}
+}
+
+// suppressTTL is how long a not-loaded refusal keeps a node out of routing.
+const suppressTTL = 60 * time.Second
+
+func (s *localState) clock() time.Time {
+	if s.now != nil {
+		return s.now()
+	}
+	return time.Now()
+}
+
+// suppress records that node refused model as not loaded.
+func (s *localState) suppress(k inflightKey) {
+	s.suppressMu.Lock()
+	defer s.suppressMu.Unlock()
+	if s.suppressed == nil {
+		s.suppressed = make(map[inflightKey]time.Time)
+	}
+	s.suppressed[k] = s.clock()
+}
+
+// suppressedAt returns when a live suppression began.
+func (s *localState) suppressedAt(k inflightKey) (time.Time, bool) {
+	s.suppressMu.Lock()
+	defer s.suppressMu.Unlock()
+	at, ok := s.suppressed[k]
+	if ok && s.clock().Sub(at) >= suppressTTL {
+		delete(s.suppressed, k)
+		return time.Time{}, false
+	}
+	return at, ok
+}
+
+// minContextLength is the smallest per-slot context over every node that
+// listed the model and is eligible for it (Loaded, Unknown or JIT). It is
+// false when no node qualifies or when any eligible node has no value: a
+// client that needs a safe window must not be handed an optimistic one.
+func (s *localState) minContextLength(engine, model string, nodeIDs []string) (int, bool) {
+	if s.capacity == nil {
+		return 0, false
+	}
+	min, any := 0, false
+	for _, id := range nodeIDs {
+		if !s.eligible(id, engine, model) {
+			continue
+		}
+		n, ok := s.capacity.CtxPerSlot(id, engine, model)
+		if !ok || n <= 0 {
+			return 0, false
+		}
+		if !any || n < min {
+			min, any = n, true
+		}
+	}
+	return min, any
+}
