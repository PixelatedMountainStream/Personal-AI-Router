@@ -0,0 +1,146 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package main
+
+// Step-5 characterization tests for the fork's proxy.go behaviour, written
+// against pre-step develop. Only the char* helpers below may change when the
+// fork state moves behind seams; the test bodies and assertions may not.
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"nvpair-proxy/local/capacity"
+	"nvpair-shared/noderec"
+	"nvpair-shared/schedulerwire"
+)
+
+// charLocal turns on the fork's routing state with capacity c (nil: none).
+func charLocal(p *Proxy, c CapacityProvider) *Proxy {
+	p.local = &localState{capacity: c}
+	return p
+}
+
+func charDirectory(engine string, nodes ...noderec.DirectoryNode) CapacityProvider {
+	d := capacity.NewDirectory(nil)
+	d.Update(engine, nodes)
+	return d
+}
+
+func charEligible(p *Proxy, id, engine, model string) bool { return p.eligible(id, engine, model) }
+
+// charReserve reserves a node for model and returns its id (the claim is kept).
+func charReserve(p *Proxy, f *facade, cands []candidate, model string) string {
+	out, res, _ := p.reserveCandidateFor(f, append([]candidate(nil), cands...), "", model)
+	if !res.held || len(out) == 0 {
+		return ""
+	}
+	return out[0].id
+}
+
+func charRanked(t *testing.T, tc engineCase, ids ...string) (*Proxy, *facade) {
+	t.Helper()
+	disc := NewDiscovery()
+	p := testProxy(tc.profile, disc, tc.profile.FacadePort)
+	ranks := make([]schedulerwire.NodeRank, len(ids))
+	for i, id := range ids {
+		ranks[i] = schedulerwire.NodeRank{ID: id, Rank: i}
+	}
+	applySnapshot(p, schedulerwire.Priority{Nodes: ids, Ranks: ranks})
+	return p, p.soleFacade()
+}
+
+// LM Studio slots: lowest occupancy per slot wins, scheduler order breaks
+// ties, and a full node is passed over while another has a free slot.
+func TestCharLMStudioSlotsBalanceThenAvoidFull(t *testing.T) {
+	tc := lmstudioCase(t)
+	p, f := charRanked(t, tc, "a", "b")
+	charLocal(p, &fakeCap{slots: map[string]int{"a": 3, "b": 1}})
+	cands := []candidate{{id: "a"}, {id: "b"}}
+	got := []string{
+		charReserve(p, f, cands, tc.requestedModel),
+		charReserve(p, f, cands, tc.requestedModel),
+		charReserve(p, f, cands, tc.requestedModel),
+		charReserve(p, f, cands, tc.requestedModel),
+	}
+	assert.Equal(t, []string{"a", "b", "a", "a"}, got)
+}
+
+// LM Studio does not JIT-load by default: a node that reports nothing loaded
+// is ineligible unless it opts in with jit_load.
+func TestCharLMStudioJITOffByDefault(t *testing.T) {
+	p := testProxy(lmstudioCase(t).profile, NewDiscovery(), 0)
+	empty := map[string][]string{"lmstudio": {}}
+	charLocal(p, charDirectory("lmstudio",
+		noderec.DirectoryNode{HostUUID: "off", LoadedByEngine: empty},
+		noderec.DirectoryNode{HostUUID: "on", LoadedByEngine: empty, LocalNodeExt: noderec.LocalNodeExt{JITLoadByEngine: map[string]bool{"lmstudio": true}}},
+	))
+	assert.False(t, charEligible(p, "off", "lmstudio", "qwen3-8b"), "jit off by default")
+	assert.True(t, charEligible(p, "on", "lmstudio", "qwen3-8b"), "jit_load opt-in")
+}
+
+// An LM Studio loaded instance makes its node eligible without JIT; another
+// model on the same node is not.
+func TestCharLMStudioLoadedInstanceEligible(t *testing.T) {
+	p := testProxy(lmstudioCase(t).profile, NewDiscovery(), 0)
+	charLocal(p, charDirectory("lmstudio",
+		noderec.DirectoryNode{HostUUID: "n", LoadedByEngine: map[string][]string{"lmstudio": {"qwen3-8b"}}},
+	))
+	assert.True(t, charEligible(p, "n", "lmstudio", "qwen3-8b"))
+	assert.False(t, charEligible(p, "n", "lmstudio", "other-model"))
+}
+
+// Inference for an advertised model nobody has loaded is a 503; for a model
+// nobody advertises it stays the upstream 502.
+func TestCharLMStudioNotLoaded503NoOwner502(t *testing.T) {
+	tc := lmstudioCase(t)
+	a, hits := newCountingServer(t, 200, "{}")
+	disc := NewDiscovery()
+	disc.AddManual(nodeForModel(t, "a", a, tc.advertisedModel))
+	p := charLocal(testProxy(tc.profile, disc, tc.profile.FacadePort), &fakeCap{res: map[string]Residency{"a": ResidencyKnownEmpty}})
+
+	rec := httptest.NewRecorder()
+	p.soleFacade().handleHTTP(rec, tc.inferenceRequest())
+	assert.Equal(t, http.StatusServiceUnavailable, rec.Code, rec.Body.String())
+
+	rec = httptest.NewRecorder()
+	p.soleFacade().handleHTTP(rec, httptest.NewRequest(http.MethodPost, tc.inferencePath, strings.NewReader(`{"model":"nobody-has-it"}`)))
+	assert.Equal(t, http.StatusBadGateway, rec.Code, rec.Body.String())
+	assert.Equal(t, 0, hits())
+}
+
+// /v1/responses mid-history developer items reach the engine rewritten, with
+// a matching Content-Length.
+func TestCharResponsesInputNormalisedBeforeForward(t *testing.T) {
+	tc := lmstudioCase(t)
+	var mu sync.Mutex
+	var gotBody string
+	var gotLen int64
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		mu.Lock()
+		gotBody, gotLen = string(b), r.ContentLength
+		mu.Unlock()
+		_, _ = io.WriteString(w, "{}")
+	}))
+	t.Cleanup(srv.Close)
+	disc := NewDiscovery()
+	disc.AddManual(nodeForModel(t, "a", srv.URL, tc.advertisedModel))
+	p := charLocal(testProxy(tc.profile, disc, tc.profile.FacadePort), nil)
+	body := `{"model":"qwen3-8b","input":[{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"}]},{"type":"message","role":"developer","content":[{"type":"input_text","text":"b"}]}]}`
+	rec := httptest.NewRecorder()
+	p.soleFacade().handleHTTP(rec, httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(body)))
+	require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+	mu.Lock()
+	defer mu.Unlock()
+	assert.Contains(t, gotBody, `"[developer]\nb"`)
+	assert.Equal(t, int64(len(gotBody)), gotLen)
+}
diff --git a/services/nvpair-proxy/local_dircapacity_test.go b/services/nvpair-proxy/local_dircapacity_test.go
new file mode 100644
index 0000000..5e62bca
--- /dev/null
+++ b/services/nvpair-proxy/local_dircapacity_test.go
@@ -0,0 +1,197 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package main
+
+import (
+	"encoding/json"
+	"nvpair-proxy/local/capacity"
+	"testing"
+	"time"
+
+	"nvpair-shared/noderec"
+)
+
+func dnode(id string, loaded []string, slots map[string]noderec.SlotInfo, obs int64) noderec.DirectoryNode {
+	n := noderec.DirectoryNode{HostUUID: id, LocalNodeExt: noderec.LocalNodeExt{ModelsObservedAt: obs}}
+	if loaded != nil {
+		n.LoadedByEngine = map[string][]string{"ollama": loaded}
+	}
+	if slots != nil {
+		n.SlotsByEngine = map[string]map[string]noderec.SlotInfo{"ollama": slots}
+	}
+	return n
+}
+
+func TestDirectoryResidencyAndProjection(t *testing.T) {
+	d := capacity.NewDirectory(nil)
+	d.Update("ollama", []noderec.DirectoryNode{
+		dnode("legacy", nil, nil, 0),
+		dnode("empty", []string{}, nil, 1),
+		dnode("hot", []string{"m"}, map[string]noderec.SlotInfo{"m": {Slots: 3, CtxPerSlot: 4096}}, 1),
+	})
+	for id, want := range map[string]Residency{"legacy": ResidencyUnknown, "empty": ResidencyKnownEmpty, "hot": ResidencyLoaded, "gone": ResidencyUnknown} {
+		if got, _ := d.Residency(id, "ollama", "m"); got != want {
+			t.Errorf("%s residency = %v, want %v", id, got, want)
+		}
+	}
+	if n, ok := d.Slots("hot", "ollama", "m"); !ok || n != 3 {
+		t.Errorf("slots = %d %v", n, ok)
+	}
+	if n, ok := d.CtxPerSlot("hot", "ollama", "m"); !ok || n != 4096 {
+		t.Errorf("ctx = %d %v", n, ok)
+	}
+	if _, ok := d.Slots("empty", "ollama", "m"); ok {
+		t.Error("slots for non-loaded model")
+	}
+}
+
+func TestDirectorySuppressionLiftedByNewerObservation(t *testing.T) {
+	now := time.Unix(1000, 0)
+	d := capacity.NewDirectory(nil)
+	p := &Proxy{local: &localState{suppressed: map[inflightKey]time.Time{}, now: func() time.Time { return now }}}
+	p.local.capacity = d
+	hot := dnode("n", []string{"m"}, nil, now.Add(-time.Second).UnixMilli())
+	p.local.suppressed[inflightKey{"ollama", "m", "n"}] = now
+	d.Update("ollama", []noderec.DirectoryNode{hot}) // delivered late, observed before the refusal
+	if p.eligible("n", "ollama", "m") {
+		t.Fatal("sweep observed before the refusal must not lift suppression")
+	}
+	hot.ModelsObservedAt = now.Add(time.Second).UnixMilli()
+	d.Update("ollama", []noderec.DirectoryNode{hot})
+	if !p.eligible("n", "ollama", "m") {
+		t.Fatal("newer sweep showing Loaded must lift suppression")
+	}
+}
+
+func TestMinContextLength(t *testing.T) {
+	d := capacity.NewDirectory(nil)
+	info := func(c int) map[string]noderec.SlotInfo {
+		return map[string]noderec.SlotInfo{"m": {Slots: 1, CtxPerSlot: c}}
+	}
+	d.Update("ollama", []noderec.DirectoryNode{
+		dnode("a", []string{"m"}, info(8192), 1),
+		dnode("b", []string{"m"}, info(4096), 1),
+		dnode("nov", []string{"m"}, map[string]noderec.SlotInfo{"m": {Slots: 1}}, 1),
+		dnode("cold", []string{}, nil, 1),
+	})
+	d.Update("lmstudio", nil)
+	p := &Proxy{local: &localState{capacity: capacity.Override{Over: capacity.Settings{JITBy: map[string]bool{"ollama": false}}, Base: d}}}
+	if n, ok := p.minContextLength("ollama", "m", []string{"a", "b", "cold"}); !ok || n != 4096 {
+		t.Fatalf("min = %d %v (cold, non-JIT node must be ignored)", n, ok)
+	}
+	if _, ok := p.minContextLength("ollama", "m", []string{"a", "nov"}); ok {
+		t.Fatal("eligible node without a value must omit the field")
+	}
+	raw := capacity.WithContextLength(json.RawMessage(`{"id":"m"}`), 4096)
+	if string(raw) != `{"context_length":4096,"id":"m"}` {
+		t.Fatalf("raw = %s", raw)
+	}
+}
+
+func TestJITBlockedWhenOtherEngineHoldsModel(t *testing.T) {
+	d := capacity.NewDirectory(nil)
+	busy := dnode("busy", []string{}, nil, 1)
+	busy.LoadedByEngine["lmstudio"] = []string{"big"}
+	free := dnode("free", []string{}, nil, 1)
+	free.LoadedByEngine["lmstudio"] = []string{}
+	d.Update("ollama", []noderec.DirectoryNode{busy, free})
+	p := &Proxy{local: &localState{capacity: d}}
+	if p.eligible("busy", "ollama", "m") {
+		t.Fatal("JIT must not add a second model beside another engine's")
+	}
+	if !p.eligible("free", "ollama", "m") {
+		t.Fatal("JIT is fine when no other engine has a model loaded")
+	}
+}
+
+func TestJITClaimBlocksOtherModel(t *testing.T) {
+	d := capacity.NewDirectory(nil)
+	d.Update("ollama", []noderec.DirectoryNode{dnode("n", []string{}, nil, 1)})
+	p := &Proxy{local: &localState{capacity: d}}
+	res := p.takeLocked("n", "ollama", "m", false)
+	if !res.jit || p.eligible("n", "ollama", "m2") || !p.eligible("n", "ollama", "m") {
+		t.Fatal("claim must block a different model only")
+	}
+	p.dropLocked(res)
+	if p.eligible("n", "ollama", "m2") {
+		t.Fatal("released claim must persist until a newer sweep")
+	}
+
+}
+
+func TestReserveRechecksEligibility(t *testing.T) {
+	d := capacity.NewDirectory(nil)
+	d.Update("ollama", []noderec.DirectoryNode{dnode("n", []string{}, nil, 1), dnode("o", []string{"m"}, nil, 1)})
+	p := affinityProxy(t, "n", "o")
+	p.local.capacity = d
+	f := p.soleFacade()
+	p.takeLocked("n", "ollama", "other", false) // another model claims n
+	round := []candidate{{id: "n"}, {id: "o"}}
+	cand, ok := p.rescoreReserve(f, round, map[string]bool{}, &reservation{}, "m")
+	if !ok || cand.id != "o" {
+		t.Fatalf("got %v %v, want o", cand.id, ok)
+	}
+}
+
+func TestObservedAtAndModelKey(t *testing.T) {
+	d := capacity.NewDirectory(nil)
+	n := dnode("n", []string{"m:latest"}, map[string]noderec.SlotInfo{"m:latest": {Slots: 2, CtxPerSlot: 99}}, 5000)
+	d.Update("ollama", []noderec.DirectoryNode{n})
+	r, at := d.Residency("n", "ollama", "m")
+	if r != ResidencyLoaded || !at.Equal(time.UnixMilli(5000)) {
+		t.Fatalf("residency %v at %v", r, at)
+	}
+	if s, ok := d.Slots("n", "ollama", "m"); !ok || s != 2 {
+		t.Fatal("slots must match m vs m:latest")
+	}
+}
+
+func TestContextLengthReplacedOrRemoved(t *testing.T) {
+	if got := string(capacity.WithContextLength(json.RawMessage(`{"id":"m","context_length":999999}`), 4096)); got != `{"context_length":4096,"id":"m"}` {
+		t.Fatal(got)
+	}
+	if got := string(capacity.WithContextLength(json.RawMessage(`{"id":"m","context_length":9}`), 0)); got != `{"id":"m"}` {
+		t.Fatal(got)
+	}
+}
+
+func TestJITReleasedClaimPersistsUntilSweepOrCap(t *testing.T) {
+	now := time.Now()
+	d := capacity.NewDirectory(nil)
+	d.Update("ollama", []noderec.DirectoryNode{dnode("n", []string{}, nil, now.UnixMilli())})
+	p := &Proxy{local: &localState{capacity: d, now: func() time.Time { return now }}}
+	p.dropLocked(p.takeLocked("n", "ollama", "m", false))
+	if p.eligible("n", "ollama", "m2") {
+		t.Fatal("claim must persist after request end")
+	}
+	now = now.Add(jitReleaseCap)
+	if !p.eligible("n", "ollama", "m2") {
+		t.Fatal("claim must expire at the cap")
+	}
+	p.dropLocked(p.takeLocked("n", "ollama", "m", false))
+	d.Update("ollama", []noderec.DirectoryNode{dnode("n", []string{}, nil, now.Add(time.Second).UnixMilli())})
+	if !p.eligible("n", "ollama", "m2") {
+		t.Fatal("a newer sweep must clear the claim")
+	}
+}
+
+func TestSelectedNodeHonoursJITClaim(t *testing.T) {
+	p := affinityProxy(t, "a")
+	d := capacity.NewDirectory(nil)
+	d.Update("ollama", []noderec.DirectoryNode{dnode("a", []string{}, nil, 1)})
+	p.local.capacity = d
+	f := p.soleFacade()
+	f.SetSelected("a")
+	engine := f.profile.Name
+	res := p.takeLocked("a", engine, "m", false)
+	if !res.jit {
+		t.Skip("engine is not JIT on this fixture")
+	}
+	if out, _, _ := p.reserveCandidateFor(f, reservationCandidates("a"), "", "m2"); len(out) != 0 {
+		t.Fatal("selected node must honour a JIT claim for another model")
+	}
+	if out, _, _ := p.reserveCandidateFor(f, reservationCandidates("a"), "", "m"); len(out) != 1 {
+		t.Fatal("same model stays allowed")
+	}
+}
