 services/nvpair-ui-broker/discovery.go     |  4 +++
 services/nvpair-ui-broker/local_ext.go     | 21 +++++++++++
 services/nvpair-ui-broker/local_s6_test.go | 41 ++++++++++++++++++++++
 4 files changed, 68 insertions(+)
